# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# --- Database ------------------------------------------------------------
# Flyway migrates as the OWNER; the application runs as a non-owner role so
# that row-level security cannot be bypassed. See infra/postgres-init/.
ALMIRA_DB_URL=jdbc:postgresql://localhost:55432/almira
ALMIRA_DB_OWNER_USER=almira
ALMIRA_DB_OWNER_PASSWORD=dev
ALMIRA_DB_APP_USER=almira_app
ALMIRA_DB_APP_PASSWORD=app_dev_password

# --- Redis (OTP store, rate limits, cache) -------------------------------
ALMIRA_REDIS_HOST=localhost
ALMIRA_REDIS_PORT=56379

# --- JWT -----------------------------------------------------------------
# Generate: openssl rand -base64 48
ALMIRA_JWT_SECRET=change-me-development-only-do-not-use-in-production-abcdefgh
ALMIRA_JWT_ACCESS_TTL_MINUTES=15
ALMIRA_JWT_REFRESH_TTL_DAYS=30

# --- OTP delivery --------------------------------------------------------
# `log` prints the code to the application log (local development only).
# `twilio` / `msg91` deliver a real SMS.
ALMIRA_OTP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
