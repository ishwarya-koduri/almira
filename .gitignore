# Build output
build/
# Android's machine-specific SDK path. This project reads ANDROID_HOME from
# ~/Developer/almira-personal/env.sh instead, so a local.properties should never
# appear — but an IDE will write one, and it must not travel.
local.properties
out/
bin/
target/
.gradle/
*.class
*.jar
# The wrapper jar is meant to be committed — Gradle's own documentation says so
# — because ./gradlew cannot start without it, and a fresh clone would otherwise
# have the script and not the jar. The exception has to be double-starred:
# anchored as `!gradle/wrapper/...` it matches only the repository root, which is
# neither app/ nor backend/, and both jars were missing from the repository
# until it was noticed.
!**/gradle/wrapper/gradle-wrapper.jar

# Secrets — never commit. Copy .env.example -> .env locally, and
# .env.production.example -> .env.production on a server.
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.p8
*.p12
*.keystore
*.jks

# IDE
.idea/
*.iml
.vscode/
*.swp

# OS
.DS_Store

# Local data
*.log
/tmp/

# Encrypted document blobs written by the filesystem storage provider.
# Local only; production writes to object storage.
var/
